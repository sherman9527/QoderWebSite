<mxfile host="app.diagrams.net" type="device"><diagram id="cbrs-concentration-chain" name="集中度不只在收入那一行"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="one" value="同一家客户&lt;br&gt;收入那一行只是它第一次出现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="100" as="geometry" /></mxCell><mxCell id="rev" value="收入占比&lt;br&gt;最大客户逐年换名字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="340" width="300" height="120" as="geometry" /></mxCell><mxCell id="ar" value="应收账款占比&lt;br&gt;比收入占比更陡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="300" height="120" as="geometry" /></mxCell><mxCell id="rel" value="关联方披露&lt;br&gt;两家互为关联方" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="340" width="300" height="120" as="geometry" /></mxCell><mxCell id="war" value="预收与递延&lt;br&gt;设备已交付、算力未交付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="340" width="300" height="120" as="geometry" /></mxCell><mxCell id="chain" value="名字换了，集中度没散&lt;br&gt;两条口径要一起看才知道" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17756E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="560" width="630" height="120" as="geometry" /></mxCell><mxCell id="equity" value="给客户的那张认股权&lt;br&gt;报表上的形状不是负债，是未来收入的抵减" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="560" width="630" height="120" as="geometry" /></mxCell><mxCell id="mra" value="合同容量不等于合同金额&lt;br&gt;过手型成本只有初始那一档计入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="630" height="110" as="geometry" /></mxCell><mxCell id="capex" value="资本开支由谁承担&lt;br&gt;客户预付，价格战先到；自己扛，折旧先到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="760" width="630" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="one" target="rev"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="one" target="ar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="one" target="rel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="one" target="war"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="rev" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="ar" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="rel" target="equity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="war" target="equity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="chain" target="mra"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="equity" target="capex"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>