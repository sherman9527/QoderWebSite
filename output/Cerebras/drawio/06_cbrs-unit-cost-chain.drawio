<mxfile host="app.diagrams.net" type="device"><diagram id="cbrs-unit-cost-chain" name="每百万 token 的成本是一条链，不是一个数"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="num" value="分子：一年要花的钱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="950" height="70" as="geometry" /></mxCell><mxCell id="dep" value="机器折旧&lt;br&gt;购置价与折旧年限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="300" height="120" as="geometry" /></mxCell><mxCell id="pow" value="电费&lt;br&gt;功耗、小时数、PUE、电价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="250" width="300" height="120" as="geometry" /></mxCell><mxCell id="ops" value="运维与网络&lt;br&gt;成本科目只给大类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="250" width="310" height="120" as="geometry" /></mxCell><mxCell id="bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="400" width="950" height="22" as="geometry" /></mxCell><mxCell id="den" value="分母：一年真实吐出的 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="450" width="950" height="70" as="geometry" /></mxCell><mxCell id="tps" value="单请求吞吐&lt;br&gt;公开，但多为自报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="550" width="300" height="120" as="geometry" /></mxCell><mxCell id="conc" value="并发路数&lt;br&gt;未披露" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="550" width="300" height="120" as="geometry" /></mxCell><mxCell id="util" value="利用率&lt;br&gt;只被当作归因，无数值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="550" width="310" height="120" as="geometry" /></mxCell><mxCell id="q" value="每百万 token 的成本&lt;br&gt;缺任一项，这个商就没有意义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17756E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="270" height="150" as="geometry" /></mxCell><mxCell id="anchor" value="公开拿到的只有两端：标价与毛利率&lt;br&gt;区间只能说明结构，量不出单位成本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="760" width="950" height="100" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="bar" target="q"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>