<mxfile host="app.diagrams.net" type="device"><diagram id="cbrs-premise-check" name="一句话里的三处断点，各自核到了什么"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="claim" value="一句标题里的速度宣称&lt;br&gt;要拆成三件事才核得动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="100" as="geometry" /></mxCell><mxCell id="model" value="模型是哪一档&lt;br&gt;代际名之下还分档，权重可直接下载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="360" width="380" height="130" as="geometry" /></mxCell><mxCell id="who" value="这数谁在什么条件下说的&lt;br&gt;厂商标称与第三方实测不是一个量纲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="380" height="130" as="geometry" /></mxCell><mxCell id="books" value="财务口径归谁管&lt;br&gt;已经上市：往后每个数回申报文件取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17756E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="360" width="380" height="130" as="geometry" /></mxCell><mxCell id="who2" value="同一页的免费档限速&lt;br&gt;换算下来恰好等于那个标称数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="380" height="120" as="geometry" /></mxCell><mxCell id="band" value="媒体报道只作旁证&lt;br&gt;引用一律落到具体文件与具体页次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="780" width="1280" height="90" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="claim" target="model"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="claim" target="who"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="claim" target="books"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="谁也不替代谁" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;dashed=1;" edge="1" parent="1" source="who" target="who2"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>