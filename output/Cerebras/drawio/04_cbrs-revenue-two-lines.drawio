<mxfile host="app.diagrams.net" type="device"><diagram id="cbrs-revenue-two-lines" name="多卖的算力没换来毛利：两条线的边际不一样"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="inc" value="收入增量拆成两块&lt;br&gt;申报文件自己给的分部口径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="100" as="geometry" /></mxCell><mxCell id="hw" value="卖系统&lt;br&gt;一次性、按订单与在手合同定价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="380" height="120" as="geometry" /></mxCell><mxCell id="cloud" value="卖算力&lt;br&gt;按用量与利用率定价、经常性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="380" height="120" as="geometry" /></mxCell><mxCell id="hwm" value="这块的增量毛利&lt;br&gt;多卖的机器换来了毛利" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17756E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="530" width="380" height="120" as="geometry" /></mxCell><mxCell id="clm" value="这块的增量毛利&lt;br&gt;多卖的算力在边际上没换来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="530" width="380" height="120" as="geometry" /></mxCell><mxCell id="hww" value="本地部署卖的是数据主权&lt;br&gt;官方原话，价格里含这一项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="730" width="380" height="110" as="geometry" /></mxCell><mxCell id="clw" value="净利可以只是一次清偿的落点&lt;br&gt;经营仍亏，要分开看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="730" width="380" height="110" as="geometry" /></mxCell><mxCell id="why" value="结构换了边&lt;br&gt;所以毛利率掉不是降价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="530" width="380" height="120" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="inc" target="hw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="inc" target="cloud"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="hw" target="hwm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="cloud" target="clm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="hwm" target="why"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="clm" target="why"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="hwm" target="hww"><mxG