<mxfile host="app.diagrams.net" type="device"><diagram id="cbrs-memory-wall" name="为什么加机器不等于变快"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1h" value="自回归解码&lt;br&gt;词与词互相依赖，逐 token 串行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="380" height="110" as="geometry" /></mxCell><mxCell id="c1b" value="每生成一个词&lt;br&gt;要把全部参数搬进计算单元一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="380" height="110" as="geometry" /></mxCell><mxCell id="c1c" value="先想再答的做法&lt;br&gt;要多几十倍的 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="380" height="110" as="geometry" /></mxCell><mxCell id="c2h" value="多接几台通用加速卡&lt;br&gt;只提高能同时接的查询数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="110" as="geometry" /></mxCell><mxCell id="c2b" value="墙钟由带宽与延迟定&lt;br&gt;不由总算力定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17756E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="380" height="110" as="geometry" /></mxCell><mxCell id="c2c" value="装不进单片就按层切&lt;br&gt;映射到多台整机，跨机又要搬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="380" height="110" as="geometry" /></mxCell><mxCell id="c3h" value="权重放片上&lt;br&gt;容量与介质官方未逐项说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="380" height="110" as="geometry" /></mxCell><mxCell id="c3b" value="权重放片外&lt;br&gt;外部内存分几档，是否落片外未说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFEC;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="380" height="110" as="geometry" /></mxCell><mxCell id="c3c" value="三个速度口径不可互换&lt;br&gt;单流、聚合、首 token 延迟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B2E8E;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="520" width="380" height="110" as="geometry" /></mxCell><mxCell id="band" value="最快与最便宜不在同一家&lt;br&gt;榜单口径仍是单请求；并发与长上下文下的曲线未见公开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFE7E4;strokeColor=#D6DEDA;fontColor=#171C1B;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="760" width="1280" height="90" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="c1h" target="c1b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="c1b" target="c1c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="不缩短它" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;dashed=1;" edge="1" parent="1" source="c2h" target="c2b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="c2b" target="c2c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="c3h" target="c3b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5A6663;fontColor=#5A6663;fontSize=13;" edge="1" parent="1" source="c3b" target="c3c"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>