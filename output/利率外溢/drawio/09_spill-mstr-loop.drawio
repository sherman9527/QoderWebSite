<mxfile host="app.diagrams.net" type="device"><diagram id="spill-mstr-loop" name="带利息的比特币仓位：循环与它的断点"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="soft" value="软件业务现金流&lt;br&gt;规模有限，是估值的锚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="320" height="96" as="geometry" /></mxCell><mxCell id="raise" value="对外融资&lt;br&gt;可转债、优先股、增发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="340" height="96" as="geometry" /></mxCell><mxCell id="buy" value="买入比特币&lt;br&gt;资产端不产生现金流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="200" width="320" height="96" as="geometry" /></mxCell><mxCell id="up" value="币价上涨&lt;br&gt;抵押物变厚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="460" width="320" height="96" as="geometry" /></mxCell><mxCell id="prem" value="市价相对持仓的溢价&lt;br&gt;溢价&gt;1 才转得动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="340" height="96" as="geometry" /></mxCell><mxCell id="dn" value="溢价消失&lt;br&gt;增发买币变难，展期成本上升" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="460" width="320" height="96" as="geometry" /></mxCell><mxCell id="int" value="付息与到期墙&lt;br&gt;靠卖币或再融资，不靠经营" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="340" height="96" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="soft" target="raise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="raise" target="buy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="buy" target="up"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="up" target="prem"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="正循环" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;dashed=1;" edge="1" parent="1" source="prem" target="raise"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="反向" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;dashed=1;" edge="1" parent="1" source="prem" target="dn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="dn" target="int"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="buy" target="int"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diag