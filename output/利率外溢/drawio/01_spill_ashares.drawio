<mxfile host="app.diagrams.net" type="device"><diagram id="01_spill_ashares" name="四条通道：一条几乎断、一条被截、一条没法核对、一条还开着"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="us" value="美国长端上行&lt;br&gt;境外那一头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="200" height="130" as="geometry" /></mxCell><mxCell id="disc" value="贴现率通道&lt;br&gt;境内现金流按本国利率折现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="140" width="300" height="150" as="geometry" /></mxCell><mxCell id="policy" value="政策对冲&lt;br&gt;降准与本币贷款报价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="310" width="300" height="150" as="geometry" /></mxCell><mxCell id="flow" value="资金流通道&lt;br&gt;北向已无官方日频口径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="480" width="300" height="150" as="geometry" /></mxCell><mxCell id="risk" value="风险偏好与汇率&lt;br&gt;不需要通道就生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="650" width="300" height="150" as="geometry" /></mxCell><mxCell id="cn" value="A 股&lt;br&gt;与美债各自定价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="370" width="240" height="150" as="geometry" /></mxCell><mxCell id="e0" valu