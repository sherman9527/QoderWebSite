<mxfile host="app.diagrams.net" type="device"><diagram id="spillover-sofi" name="SOFI 的息差被两头同时咬"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="liab" value="负债端&lt;br&gt;存款成本随市场利率上抬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="340" height="96" as="geometry" /></mxCell><mxCell id="asset" value="资产端&lt;br&gt;贷款重定价更快" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="200" width="340" height="96" as="geometry" /></mxCell><mxCell id="nim" value="净息差&lt;br&gt;两端的先后与幅度决定方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="340" height="96" as="geometry" /></mxCell><mxCell id="credit" value="无抵押个人贷款&lt;br&gt;违约是失业率的函数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="340" height="96" as="geometry" /></mxCell><mxCell id="prov" value="拨备与冲销&lt;br&gt;加息后期才显形" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="440" width="340" height="96" as="geometry" /></mxCell><mxCell id="fund" value="批发资金占比&lt;br&gt;越低越扛得住挤兑式重定价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="340" height="96" as="geometry" /></mxCell><mxCell id="val2" value="估值&lt;br&gt;折现率与违约预期同时收紧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="680" width="340" height="96" as="geometry" /></mxCell><mxCell id="note" value="两条通道可能同向，也可能背离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="680" width="340" height="84" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="liab" target="nim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="asset" target="nim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="fund" target="liab"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="nim" target="credit"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="credit" target="prov"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="nim" target="val2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="prov" target="val2"><mxGeometry relative="1" as="geometry" /></mxCell>