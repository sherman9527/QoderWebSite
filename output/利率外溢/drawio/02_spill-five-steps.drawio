<mxfile host="app.diagrams.net" type="device"><diagram id="spill-five-steps" name="读这类标题时的五步核对"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s1" value="第一步：看现值&lt;br&gt;写下所指那一天的收盘值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="s2" value="第二步：分清序列&lt;br&gt;国债收益率还是房贷利率，两者常年差一截" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="s3" value="第三步：分清水平与速度&lt;br&gt;位置高不等于抬升快" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="s4" value="第四步：分名义与实际&lt;br&gt;扣掉通胀预期那一块再比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="420" width="380" height="110" as="geometry" /></mxCell><mxCell id="s5" value="第五步：问同期还有什么&lt;br&gt;本国政策、信用环境、汇率各会抢戏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="380" height="110" as="geometry" /></mxCell><mxCell id="out" value="五步都过了，才谈得上「方向」&lt;br&gt;任何一步没过，标题就只是一句话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="420" width="380" height="110" as="geometry" /></mxCell><mxCell id="band" value="这一串不是仪式，是为了让标题里那个百分比有一个可核对的所指&lt;br&gt;同一段标题里，两条序列、两种口径、两个市场可以同时成立又互相矛盾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="660" width="1280" height="100" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="s5" target="out"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>