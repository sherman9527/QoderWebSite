<mxfile host="app.diagrams.net" type="device"><diagram id="spillover-hk" name="港息的进口路径"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="fed" value="美联储决策&lt;br&gt;联邦基金目标利率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="300" height="96" as="geometry" /></mxCell><mxCell id="peg" value="联系汇率&lt;br&gt;强弱方保证区间自动跟随" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="340" height="96" as="geometry" /></mxCell><mxCell id="base" value="金管局基准利率&lt;br&gt;贴现率窗口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="200" width="330" height="96" as="geometry" /></mxCell><mxCell id="hibor" value="HIBOR&lt;br&gt;银行同业资金价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="420" width="340" height="96" as="geometry" /></mxCell><mxCell id="liq" value="银行体系总结余&lt;br&gt;弱方触发时收缩" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="420" width="330" height="96" as="geometry" /></mxCell><mxCell id="bank" value="本地银行&lt;br&gt;贷款跟息、存款成本同向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="300" height="96" as="geometry" /></mxCell><mxCell id="prop" value="地产与内房&lt;br&gt;港元债 + 人民币收入