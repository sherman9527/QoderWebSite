<mxfile host="app.diagrams.net" type="device"><diagram id="spillover-housing" name="高房贷为什么先压成交量而不是房价"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="rate" value="房贷利率抬升&lt;br&gt;零售端，含利差与成本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="320" height="96" as="geometry" /></mxCell><mxCell id="afford" value="可负担性下降&lt;br&gt;同收入支撑的房价变低" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="340" height="96" as="geometry" /></mxCell><mxCell id="buy" value="买家退出&lt;br&gt;不是不想要，是算不过来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="200" width="320" height="96" as="geometry" /></mxCell><mxCell id="lock" value="锁定效应&lt;br&gt;存量低息贷款不愿换房" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="340" height="96" as="geometry" /></mxCell><mxCell id="inv" value="挂牌库存不增&lt;br&gt;卖盘也被冻住" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="440" width="320" height="96" as="geometry" /></mxCell><mxCell id="vol" value="成交量先掉&lt;br&gt;这条是确定的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="680" width="340" height="96" as="geometry" /></mxCell><mxCell id="price" value="价格方向不定&lt;br&gt;供给同时收缩，抵消下跌压力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="680" width="320" height="96" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="rate" target="afford"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="afford" target="buy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="rate" target="lock"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="lock" target="inv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="buy" target="vol"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="inv" target="vol"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="同时托住" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;dashed=1;" edge="1" parent="1" source="inv" target="price"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="vol" target="price"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagra