<mxfile host="app.diagrams.net" type="device"><diagram id="spill-observe" name="不预测方向，只把方向换成可核对的量"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="一条利率线，四个可核对的观测面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="460" height="90" as="geometry" /></mxCell><mxCell id="curve" value="形状&lt;br&gt;长短端利差：比水平更早动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="320" height="110" as="geometry" /></mxCell><mxCell id="real2" value="构成&lt;br&gt;实际利率与预期通胀分开报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="320" height="110" as="geometry" /></mxCell><mxCell id="spread" value="利差&lt;br&gt;国债与房贷不是一个数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="400" width="320" height="110" as="geometry" /></mxCell><mxCell id="flow" value="资金&lt;br&gt;谁在买、以什么口径被计量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="660" width="320" height="110" as="geometry" /></mxCell><mxCell id="price" value="价格&lt;br&gt;成交先动，价格后动或不动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="660" width="320" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="end