<mxfile host="app.diagrams.net" type="device"><diagram id="ust7-equity-channels" name="同一个利率，两条方向相反的通道"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="y" value="长端利率上行&lt;br&gt;实际利率与预期通胀分开看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="96" as="geometry" /></mxCell><mxCell id="disc" value="贴现通道&lt;br&gt;折现率抬高，长久期资产压得更多" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="400" width="380" height="110" as="geometry" /></mxCell><mxCell id="earn" value="盈利通道&lt;br&gt;需求、利息支出与美元同时受影响" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="380" height="110" as="geometry" /></mxCell><mxCell id="growth" value="未盈利成长股&lt;br&gt;久期最长，首当其冲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="660" width="380" height="96" as="geometry" /></mxCell><mxCell id="bank" value="银行与保险&lt;br&gt;息差受益，但持仓跌价进资本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="380" height="96" as="geometry" /></mxCell><mxCell id="util" value="公用事业与地产&lt;br&gt;类债资产，被同一把尺子量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="380" height="96" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="y" target="disc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="y" target="earn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="disc" target="growth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="disc" target="util"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#615F52;fontColor=#615F52;fontSize=13;" edge="1" parent="1" source="earn" target="bank"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>