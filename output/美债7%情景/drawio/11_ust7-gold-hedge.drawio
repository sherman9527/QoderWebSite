<mxfile host="app.diagrams.net" type="device"><diagram id="ust7-gold-hedge" name="金价不是一条逻辑赢了，而是两条对冲的结果"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="real" value="实际利率&lt;br&gt;持有黄金的机会成本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#155E6B;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="380" height="100" as="geometry" /></mxCell><mxCell id="cost" value="压制金价的力&lt;br&gt;无息资产，利率越高越贵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E6D2;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="400" width="360" height="100" as="geometry" /></mxCell><mxCell id="hedge" value="顶住金价的力&lt;br&gt;央行购金、场外与避险需求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8A8421;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="360" height="100" as="geometry" /></mxCell><mxCell id="scale" value="两力对冲&lt;br&gt;谁赢取决于当期哪条更强" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="380" height="100" as="geometry" /></mxCell><mxCell id="watch" value="季度央行购金量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="660" width="320" height="96" as="geometry" /></mxCell><mxCell id="etf" value="ETF 持仓吨数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEBE1;strokeColor=#DDD9C9;fontColor=#1D1D17;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="660" width="260" height="96" as="geometry" /></mxCell><mxCell id="dfii" value="实际利率水平" style="rounded=1