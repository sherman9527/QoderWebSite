<mxfile host="app.diagrams.net" type="device"><diagram id="failure-map" name="上线后最先炸的五种，和各自的第一现场"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="f1" value="工具循环不收敛&lt;br&gt;看：单回合调用次数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="220" width="260" height="100" as="geometry" /></mxCell><mxCell id="f2" value="流式被代理缓冲&lt;br&gt;看：首字时间与字节到达节奏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="260" height="100" as="geometry" /></mxCell><mxCell id="f3" value="幻觉出不存在的工具名&lt;br&gt;看：调用名是否在注册表里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="220" width="260" height="100" as="geometry" /></mxCell><mxCell id="f4" value="旧资料与新数据打架&lt;br&gt;看：检索快照与语料版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="220" width="260" height="100" as="geometry" /></mxCell><mxCell id="f5" value="把内部推理当事实&lt;br&gt;看：渲染前有没有校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="220" width="210" height="100" as="geometry" /></mxCell><mxCell id="base" value="共同前提：每一项都要能在 5 分钟内确认是不是它&lt;br&gt;看哪个字段、哪条日志、哪张表——写进故障表，不靠现场猜" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="720" height="100" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="f1" target="base"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="f2" target="base"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="f3" target="base"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="f4" target="base"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="f5" target="base"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>