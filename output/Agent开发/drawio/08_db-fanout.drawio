<mxfile host="app.diagrams.net" type="device"><diagram id="db-fanout" name="一次回合并行调工具，库连接数会先打满"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="svc" value="service 层&lt;br&gt;超时、重试、次数上限都在这" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="160" width="320" height="110" as="geometry" /></mxCell><mxCell id="cli" value="模型客户端&lt;br&gt;连接超时与读超时分开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="400" width="320" height="110" as="geometry" /></mxCell><mxCell id="lim" value="回合预算&lt;br&gt;最多调几次，超了就断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="320" height="110" as="geometry" /></mxCell><mxCell id="repo" value="数据访问&lt;br&gt;只读账号 + 列白名单 + 限行数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="400" width="320" height="110" as="geometry" /></mxCell><mxCell id="sql" value="原始 SQL / 任意 URL&lt;br&gt;一律拒绝，并回可行动的错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="640" width="320" height="110" as="geometry" /></mxCell><mxCell id="audit" value="审计与脱敏日志&lt;br&gt;不落原文与密钥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="640" width="320" height="110" as="geometry" /></mxCell><mx