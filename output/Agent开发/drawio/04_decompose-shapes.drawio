<mxfile host="app.diagrams.net" type="device"><diagram id="decompose-shapes" name="拆解能长成三种样子，每种都要被校验"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="q" value="用户的一句话&lt;br&gt;「这单为什么还没到」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="78" as="geometry" /></mxCell><mxCell id="plan" value="计划清单&lt;br&gt;有序步骤，最好读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="340" height="96" as="geometry" /></mxCell><mxCell id="tree" value="子问题树&lt;br&gt;有分支：先查状态再定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="340" height="96" as="geometry" /></mxCell><mxCell id="dag" value="DAG&lt;br&gt;有依赖，可并行，可局部失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="340" height="96" as="geometry" /></mxCell><mxCell id="gate" value="共同前提：这也是模型输出&lt;br&gt;所以必须过格式校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="380" height="78" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="q" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fo