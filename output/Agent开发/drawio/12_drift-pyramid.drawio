<mxfile host="app.diagrams.net" type="device"><diagram id="drift-pyramid" name="答案不漂移：三层断言 + 两条前提"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="top" value="语义层&lt;br&gt;评审模型或相似度，只给阈值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="400" height="96" as="geometry" /></mxCell><mxCell id="mid" value="事实层&lt;br&gt;关键数字与实体必须落在允许集合里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="720" height="96" as="geometry" /></mxCell><mxCell id="base" value="契约层 + 调用层&lt;br&gt;结构必须合 schema；该调哪个工具、调几次，比答案文字稳得多" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="490" width="1040" height="96" as="geometry" /></mxCell><mxCell id="stat" value="同一题跑 N 次看通过率&lt;br&gt;单次通过或失败没有信息量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="420" height="96" as="geometry" /></mxCell><mxCell id="snap" value="模型版本与检索快照固定&lt;br&gt;否则测到的是世界变了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="420" height="96" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="base" target="stat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;dashed=1;" edge="1" parent="1" source="mid" target="stat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="可复现的前提" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="snap" target="stat"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>