<mxfile host="app.diagrams.net" type="device"><diagram id="format-loop" name="格式不是「模型答应了就行」：契约、校验、修复回环"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="schema" value="① 契约&lt;br&gt;用 schema 约束解码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="200" width="320" height="96" as="geometry" /></mxCell><mxCell id="gen" value="② 生成&lt;br&gt;带枚举、必填、取值范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="400" width="320" height="96" as="geometry" /></mxCell><mxCell id="check" value="③ 校验&lt;br&gt;语法 + 业务规则两遍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="320" height="96" as="geometry" /></mxCell><mxCell id="fix" value="失败：带错误重试一次&lt;br&gt;次数必须封顶" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="640" width="320" height="96" as="geometry" /></mxCell><mxCell id="render" value="④ 渲染&lt;br&gt;校验不过的一律不显示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="400" width="300" height="96" as="geometry" /></mxCell><mxCell id="note" value="旁白里的数字仍要来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="640" width="300" height="84" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="schema" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="gen" target="check"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="通过" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="check" target="render"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="不通过" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;dashed=1;" edge="1" parent="1" source="check" target="fix"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="再试" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;dashed=1;" edge="1" parent="1" source="fix" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="caption 走正文规则" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;dashed=1;" edge="1" parent="1" source="render" target="note"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>