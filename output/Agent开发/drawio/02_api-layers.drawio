<mxfile host="app.diagrams.net" type="device"><diagram id="api-layers" name="为什么必须有一层后端代理"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="fe" value="浏览器&lt;br&gt;只拿得到会话 id 与文本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="220" width="330" height="110" as="geometry" /></mxCell><mxCell id="be" value="后端 service&lt;br&gt;唯一持有密钥的一层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="330" height="110" as="geometry" /></mxCell><mxCell id="mdl" value="模型端点&lt;br&gt;按回合被调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="220" width="330" height="110" as="geometry" /></mxCell><mxCell id="db" value="数据&lt;br&gt;只经参数化查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="330" height="110" as="geometry" /></mxCell><mxCell id="leak" value="密钥进了前端 = 公开&lt;br&gt;查看源码就能拿到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="560" width="330" height="110" as="geometry" /></mxCell><mxCell id="e0" value="同源请求" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="fe" target="be"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6