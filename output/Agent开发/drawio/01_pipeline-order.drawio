<mxfile host="app.diagrams.net" type="device"><diagram id="pipeline-order" name="十二道工序，以及它们为什么是这个顺序"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1" value="01 定接口与调用形态&lt;br&gt;端点、鉴权、部署名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="300" height="100" as="geometry" /></mxCell><mxCell id="p2" value="02 后端代理&lt;br&gt;唯一能持密钥的一层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="165" width="300" height="100" as="geometry" /></mxCell><mxCell id="p3" value="03 单轮无工具最小闭环&lt;br&gt;一个输入框 + 一段回复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="165" width="300" height="100" as="geometry" /></mxCell><mxCell id="p4" value="04 流式&lt;br&gt;事件契约先定再写 UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="165" width="300" height="100" as="geometry" /></mxCell><mxCell id="p5" value="05 工具注册表&lt;br&gt;描述、实现、权限三件事" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="375" width="300" height="100" as="geometry" /></mxCell><mxCell id="p6" value="06 数据访问&lt;br&gt;只读视图 + 参数化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="375" width="300" height="100" as="geometry" /></mxCell><mxCell id="p7" value="07 拆解与展示&lt;br&gt;声明，不是内心戏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="375" width="300" height="100" as="geometry" /></mxCell><mxCell id="p8" value="08 格式契约&lt;br&gt;schema + 修复回环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="300" height="100" as="geometry" /></mxCell><mxCell id="p9" value="09 会话持久化&lt;br&gt;历史由后端拥有" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="585" width="300" height="100" as="geometry" /></mxCell><mxCell id="p10" value="10 取消与重试&lt;br&gt;停止要真的中止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="585" width="300" height="100" as="geometry" /></mxCell><mxCell id="p11" value="11 评测与防漂移&lt;br&gt;同一题跑 N 次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="585" width="300" height="100" as="geometry" /></mxCell><mxCell id="p12" value="12 上线清单&lt;br&gt;每条都要能被验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="585" width="300" height="100" as="geometry" /></mxCell><mxCell id="bad" value="最常见的错序：先把聊天 UI 画漂亮&lt;br&gt;最后才发现密钥不能进前端，整层要重写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="745" width="660" height="90" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B666