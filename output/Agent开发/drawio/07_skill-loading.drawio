<mxfile host="app.diagrams.net" type="device"><diagram id="skill-loading" name="渐进披露：为什么不能把所有说明书都塞进去"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="idx" value="技能清单&lt;br&gt;名称 + 什么时候用它，常驻上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="330" height="110" as="geometry" /></mxCell><mxCell id="pick" value="命中判断&lt;br&gt;由这轮问题决定读哪一篇" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="300" height="110" as="geometry" /></mxCell><mxCell id="body" value="技能正文 A&lt;br&gt;按需注入，读完即走" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="200" width="330" height="110" as="geometry" /></mxCell><mxCell id="body2" value="技能正文 B&lt;br&gt;没命中就不占位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="330" height="110" as="geometry" /></mxCell><mxCell id="tool" value="工具注册表&lt;br&gt;技能只说顺序，执行仍在工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#33507A;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="620" width="300" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="idx" target="pick"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeCol