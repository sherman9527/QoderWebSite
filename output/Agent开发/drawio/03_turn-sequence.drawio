<mxfile host="app.diagrams.net" type="device"><diagram id="turn-sequence" name="一次回合：提问从浏览器走到模型再走回来"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="l0" value="浏览器&lt;br&gt;只有展示状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="270" height="720" as="geometry" /></mxCell><mxCell id="l1" value="后端 service&lt;br&gt;唯一的真相来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="270" height="720" as="geometry" /></mxCell><mxCell id="l2" value="模型端点&lt;br&gt;无状态，每次重发历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="140" width="270" height="720" as="geometry" /></mxCell><mxCell id="l3" value="数据库&lt;br&gt;只被工具问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="270" height="720" as="geometry" /></mxCell><mxCell id="b1" value="① 用户提问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="230" height="60" as="geometry" /></mxCell><mxCell id="b2" value="② 落库 + 拼上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="250" width="230" height="60" as="geometry" /></mxCell><mxCell id="b3" value="③ 调模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=