<mxfile host="app.diagrams.net" type="device"><diagram id="framework-tradeoff" name="自研、框架、托管：三种不同的还债方式"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="own" value="自研主循环&lt;br&gt;读得懂、可控；重试取消观测全得自己写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="260" width="360" height="130" as="geometry" /></mxCell><mxCell id="fw" value="框架&lt;br&gt;起步快、连接器多；抽象层调试贵、版本会破" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="360" height="130" as="geometry" /></mxCell><mxCell id="host" value="平台托管&lt;br&gt;省事；数据路径与提示词控制权交出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEFE8;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="260" width="320" height="130" as="geometry" /></mxCell><mxCell id="axis" value="判断只看四件事&lt;br&gt;工具数、异构数据源、是否跨模型、谁维护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F5D3C;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="560" width="360" height="110" as="geometry" /></mxCell><mxCell id="pick" value="这篇选哪条&lt;br&gt;自研循环 + 自己写工具注册表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE8DF;strokeColor=#D7DED6;fontColor=#181D19;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="560" width="360" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="own" target="axis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="fw" target="axis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="host" target="axis"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5B6660;fontColor=#5B6660;fontSize=13;" edge="1" parent="1" source="axis" target="pick"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>