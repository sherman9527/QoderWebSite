<mxfile host="app.diagrams.net" type="device"><diagram id="owr-comparability" name="可比性先过三筛，再谈那两头夹住定价的锚"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="two" value="两条报价要进同一张表&lt;br&gt;先过筛；断一条，比较就退成叙事" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="100" as="geometry" /></mxCell><mxCell id="f1" value="筛一：卖的是同一层&lt;br&gt;推理接口、训练集群，还是整机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="320" width="380" height="120" as="geometry" /></mxCell><mxCell id="f2" value="筛二：同一类客户&lt;br&gt;超大买家，还是长尾开发者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="380" height="120" as="geometry" /></mxCell><mxCell id="f3" value="筛三：资本结构同类&lt;br&gt;自己流片、外购加速卡，或两者都不占" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="320" width="380" height="120" as="geometry" /></mxCell><mxCell id="chip" value="自研芯片没出现在标价里&lt;br&gt;几家把同一份权重标成同一串数字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="380" height="120" as="geometry" /></mxCell><mxCell id="grade" value="拉开的是档位与区域&lt;br&gt;优先级与地域各乘一档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="380" height="120" as="geometry" /></mxCell><mxCell id="anchor" value="速度数字不能直接对照&lt;br&gt;模型、量化、上下文、是否含排队，任一项不同即不可比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="520" width="380" height="120" as="geometry" /></mxCell><mxCell id="rent" value="锚的一头：租赁市场价&lt;br&gt;折旧写在市场价里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="740" width="560" height="110" as="geometry" /></mxCell><mxCell id="eco" value="锚的另一头：公价与生态&lt;br&gt;换生态的成本被当成卖点写进文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="740" width="560" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="two" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="two" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="two" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="f1" target="chip"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="f2" target="grade"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="f3" target="anchor"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="自研芯片公司的毛利上限被这两头夹住" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="rent" target="eco"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>