<mxfile host="app.diagrams.net" type="device"><diagram id="owr-eight-traps" name="三步核对法，与它要拦下的八种误读"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="step1" value="第一步：定锚&lt;br&gt;写下这个数字的分子与分母" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="step2" value="第二步：同日重算&lt;br&gt;跨日的两个数不构成比较" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="step3" value="第三步：勾验&lt;br&gt;问它写在哪份文件、哪一期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="290" width="1280" height="16" as="geometry" /></mxCell><mxCell id="t1" value="把年化当现状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="340" width="300" height="100" as="geometry" /></mxCell><mxCell id="t2" value="把标称吞吐当实测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="340" width="300" height="100" as="geometry" /></mxCell><mxCell id="t3" value="把一次性收益当盈利能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="340" width="300" height="100" as="geometry" /></mxCell><mxCell id="t4" value="把合同容量当合同金额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="340" width="320" height="100" as="geometry" /></mxCell><mxCell id="t5" value="把客户数当客户独立性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="460" width="300" height="100" as="geometry" /></mxCell><mxCell id="t6" value="把市销率当可比倍数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="460" width="300" height="100" as="geometry" /></mxCell><mxCell id="t7" value="把一级抬价当二级定价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="460" width="300" height="100" as="geometry" /></mxCell><mxCell id="t8" value="把开源模型上限当自家能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="460" width="320" height="100" as="geometry" /></mxCell><mxCell id="out" value="把方法留下&lt;br&gt;每个数字都挂来源与期次；下一步是自己去核最新一期，而不是相信这里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A8C;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="640" width="1280" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>