<mxfile host="app.diagrams.net" type="device"><diagram id="owr-three-ways-to-break" name="三种失效方式，各自先出现什么征兆"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="root" value="这套逻辑的三条前提&lt;br&gt;每条只配一个可重复的读数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="100" as="geometry" /></mxCell><mxCell id="a" value="甲：速度溢价会被追平&lt;br&gt;通用推理栈的优化在压单位成本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="320" width="380" height="120" as="geometry" /></mxCell><mxCell id="b" value="乙：价格战打穿毛利&lt;br&gt;同一份权重人人可托管，下限是电力加折旧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="380" height="120" as="geometry" /></mxCell><mxCell id="c" value="丙：集中度换了名字&lt;br&gt;收入端降、应收端不降" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="320" width="380" height="120" as="geometry" /></mxCell><mxCell id="ra" value="先看的读数&lt;br&gt;同一取数日重算：速度比与价格比是否收敛" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="380" height="130" as="geometry" /></mxCell><mxCell id="rb" value="先看的读数&lt;br&gt;分部毛利率，与最大客户之外的收入占比" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="380" height="130" as="geometry" /></mxCell><mxCell id="rc" value="先看的读数&lt;br&gt;收入端与应收端两个占比是否同向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="520" width="380" height="130" as="geometry" /></mxCell><mxCell id="chain" value="三环断一环，估值就只是叙事&lt;br&gt;速度只是收入的形式：能不能变成钱，看单位成本、可比性与资本开支由谁承担" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A8C;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="760" width="1280" height="100" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="c"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="a" target="ra"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="b" target="rb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="c" target="rc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="ra" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="rb" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="rc" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>