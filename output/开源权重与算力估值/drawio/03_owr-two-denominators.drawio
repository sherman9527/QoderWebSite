<mxfile host="app.diagrams.net" type="device"><diagram id="owr-two-denominators" name="同一个倍数，分子分母各有几个口径"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="num" value="分子：市值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="560" height="70" as="geometry" /></mxCell><mxCell id="s1" value="发行后即刻股数&lt;br&gt;不含超额配售" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="270" height="110" as="geometry" /></mxCell><mxCell id="s2" value="期末三类合计&lt;br&gt;每个季度都在变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="250" width="270" height="110" as="geometry" /></mxCell><mxCell id="s3" value="封面股数&lt;br&gt;更新到最近一次申报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="380" width="270" height="110" as="geometry" /></mxCell><mxCell id="s4" value="含潜在股份&lt;br&gt;期权与转换还在后面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="270" height="110" as="geometry" /></mxCell><mxCell id="den" value="分母：收入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="560" width="560" height="70" as="geometry" /></mxCell><mxCell id="r1" value="上一个完整年度&lt;br&gt;最慢的那一格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="660" width="270" height="110" as="geometry" /></mxCell><mxCell id="r2" value="半年乘二&lt;br&gt;下半年通常比上半年少" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="270" height="110" as="geometry" /></mxCell><mxCell id="ratio" value="倍数&lt;br&gt;换任一口径都算得出来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A8C;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="380" width="300" height="150" as="geometry" /></mxCell><mxCell id="warn" value="变的是口径&lt;br&gt;不是公司" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="380" width="210" height="150" as="geometry" /></mxCell><mxCell id="band" value="当期报表量不到的那一头&lt;br&gt;成本结构与可复制性，要往后看几季" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="560" height="110" as="geometry" /></mxCell><mxCell id="real" value="本篇只给算法&lt;br&gt;不给目标市值，也不说贵或便宜" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="660" width="560" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="num" target="ratio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="den" target="ratio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="ratio" target="warn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;dashed=1;" edge="1" parent="1" source="real" target="ratio"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>