<mxfile host="app.diagrams.net" type="device"><diagram id="owr-five-axes" name="权重不要钱之后，竞争发生在哪五个维度"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="root" value="同一份权重人人可卖&lt;br&gt;稀缺项从「有没有」挪到了「好不好」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="380" height="110" as="geometry" /></mxCell><mxCell id="a1" value="单价&lt;br&gt;输入与输出分开标价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="250" height="130" as="geometry" /></mxCell><mxCell id="a2" value="吞吐&lt;br&gt;标称与实测不是一回事" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="380" width="250" height="130" as="geometry" /></mxCell><mxCell id="a3" value="可用性&lt;br&gt;限速与配额决定能不能用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="380" width="250" height="130" as="geometry" /></mxCell><mxCell id="a4" value="合规&lt;br&gt;数据落到哪个辖区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="250" height="130" as="geometry" /></mxCell><mxCell id="a5" value="上下文&lt;br&gt;芯片换不动这一项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A8C;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="380" width="220" height="130" as="geometry" /></mxCell><mxCell id="band" value="前两项能靠单位成本解释，后三项由模型结构与软件栈决定&lt;br&gt;所以「更快更便宜」只覆盖了一半的竞争面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="580" width="1300" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="root" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>