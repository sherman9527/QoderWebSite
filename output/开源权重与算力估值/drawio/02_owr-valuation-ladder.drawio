<mxfile host="app.diagrams.net" type="device"><diagram id="owr-valuation-ladder" name="每一级价格，是谁在什么前提下定的"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1" value="优先股认购价&lt;br&gt;对手是战略投资人，带清算优先" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="240" height="100" as="geometry" /></mxCell><mxCell id="p2" value="远期合同的结算公允价值&lt;br&gt;报表上是负债，无人付款" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="660" width="240" height="100" as="geometry" /></mxCell><mxCell id="p3" value="新一轮认购价&lt;br&gt;同期还有对员工的要约回购" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="540" width="240" height="100" as="geometry" /></mxCell><mxCell id="p4" value="董事会认定的公允价值&lt;br&gt;估值模型输出，无人付款" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E5EF;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="240" height="100" as="geometry" /></mxCell><mxCell id="p5" value="公开发行价&lt;br&gt;承销商与订单簿，可连续竞价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B3A8C;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="240" height="100" as="geometry" /></mxCell><mxCell id="sep" value="一级与二级不可互证&lt;br&gt;一级含流动性折价、对手是员工与战投；二级可做空、进指数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A5B3F;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="1360" height="100" as="geometry" /></mxCell><mxCell id="conv" value="优先股转普通股的比例不是一比一&lt;br&gt;普通股排在后面，先看谁先拿钱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="520" height="100" as="geometry" /></mxCell><mxCell id="dil" value="买入价与发行后备考每股净资产之间那段&lt;br&gt;叫摊薄，不叫亏损" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECF3;strokeColor=#D7DCE6;fontColor=#161A22;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="520" height="100" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;dashed=1;" edge="1" parent="1" source="conv" target="dil"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#5C6472;fontColor=#5C6472;fontSize=13;" edge="1" parent="1" source="dil" target="sep"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>